with "flyology_postgres.gpr";
project Postgres_Client_Operations_Benchmark is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("postgres_client_operations_benchmark.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O3", "-gnat2022", "-gnatn", "-gnatW8");
   end Compiler;
end Postgres_Client_Operations_Benchmark;
