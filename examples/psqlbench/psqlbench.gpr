with "flyology.gpr";
with "flyology_http.gpr";
with "flyology_postgres.gpr";
with "utilada_sys.gpr";

project Psqlbench is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("psqlbench.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatW8", "-gnatyg", "-O0", "-g");
   end Compiler;
end Psqlbench;
