with "flyology_postgres.gpr";
with "config/flyology_psqlish_config.gpr";
project Flyology_Psqlish is

   for Languages use ("Ada");
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Flyology_Psqlish_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("flyology_psql.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Psqlish_Config.Ada_Compiler_Switches
        & ("-gnatwa", "-gnatwe", "-gnatwJ");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Flyology_Psqlish;
