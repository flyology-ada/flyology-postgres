with "psqlish.gpr";
with "config/psqlish_tests_config.gpr";
project Psqlish_Tests is

   for Languages use ("Ada");
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Psqlish_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("fixture_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Psqlish_Tests_Config.Ada_Compiler_Switches
        & ("-gnatwa", "-gnatwe", "-gnatwJ");
   end Compiler;

end Psqlish_Tests;
