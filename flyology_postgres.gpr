with "flyology.gpr";
with "hmac_ada.gpr";
with "system_random.gpr";
with "config/flyology_postgres_config.gpr";
project Flyology_Postgres is

   for Languages use ("Ada");
   for Library_Name use "Flyology_Postgres";
   for Library_Version use Project'Library_Name & ".so." & Flyology_Postgres_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");

   type Documentation_Mode_Type is ("false", "true");
   Documentation_Mode : Documentation_Mode_Type :=
     external ("FLYOLOGY_POSTGRES_DOCUMENTATION", "false");
   case Documentation_Mode is
      when "false" =>
         null;
      when "true" =>
         --  Client, protocol, replication, server, authentication, and
         --  transport surfaces, plus the SCRAM core needed to resolve public
         --  subtype declarations. Framing, wire, and control children are
         --  internal implementation units and are omitted.
         for Source_Files use
           ("flyology-postgres.ads",
            "flyology-postgres-client.ads",
            "flyology-postgres-client_sockets.ads",
            "flyology-postgres-protocol.ads",
            "flyology-postgres-replication.ads",
            "flyology-postgres-replication-base_backups.ads",
            "flyology-postgres-replication-base_backups-server_sessions.ads",
            "flyology-postgres-replication-logical.ads",
            "flyology-postgres-replication-logical-producer.ads",
            "flyology-postgres-replication-managed_primary.ads",
            "flyology-postgres-replication-persistence.ads",
            "flyology-postgres-replication-persistence-memory.ads",
            "flyology-postgres-replication-prepared_consumer.ads",
            "flyology-postgres-replication-server_sessions.ads",
            "flyology-postgres-scram.ads",
            "flyology-postgres-scram_core.ads",
            "flyology-postgres-server.ads",
            "flyology-postgres-server_sessions.ads",
            "flyology-postgres-transports.ads",
            "flyology-postgres-transports-connections.ads",
            "flyology-postgres-transports-sockets.ads",
            "flyology-postgres-transports-tls_sockets.ads");
   end case;

   for Object_Dir use "obj/" & Flyology_Postgres_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("FLYOLOGY_POSTGRES_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Postgres_Config.Ada_Compiler_Switches
        & ("-gnateDFLYOLOGY_CONNECTION_TEST_HOOKS=False");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Documentation is
      for Excluded_Project_Files use
        (external ("FLYOLOGY_ROOT", "../flyology") & "/flyology.gpr",
         external
           ("FLYOLOGY_POSTGRES_HMAC_PROJECT", "hmac_ada.gpr"),
         external
           ("FLYOLOGY_POSTGRES_RANDOM_PROJECT", "system_random.gpr"));
      for Resources_Dir ("html") use "docs/gnatdoc/html";
   end Documentation;

end Flyology_Postgres;
