with "flyology.gpr";
with "hmac_ada.gpr";
with "system_random.gpr";
with "config/flyology_postgres_config.gpr";
project Flyology_Postgres is

   for Languages use ("Ada");
   for Library_Name use "Flyology_Postgres";
   for Library_Version use Project'Library_Name & ".so." & Flyology_Postgres_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Flyology_Postgres_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("FLYOLOGY_POSTGRES_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Postgres_Config.Ada_Compiler_Switches
        & ("-gnateDFLYOLOGY_CONNECTION_TEST_HOOKS=False");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Flyology_Postgres;
