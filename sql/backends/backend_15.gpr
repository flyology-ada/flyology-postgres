with "../config/sql_config.gpr";
project Backend_15 is

   for Languages use ("C");
   for Source_Dirs use
     ("v15/vendor",
      "v15/vendor/src",
      "v15/vendor/protobuf",
      "v15/vendor/vendor/protobuf-c",
      "v15/vendor/src/postgres");
   for Object_Dir use "obj/v15";
   for Create_Missing_Dirs use "True";
   for Library_Name use "flyology_pg_query_15";
   for Library_Dir use "lib";
   for Library_Kind use "relocatable";

   case Sql_Config.Alire_Host_OS is
      when "macos" =>
         for Library_Options use
           ("-Wl,-unexported_symbols_list," & Project'Project_Dir & "runtime_hidden.macos");
      when "windows" => null;
      when others =>
         for Library_Options use
           ("-Wl,--version-script=" & Project'Project_Dir & "exports_15.map");
   end case;

   package Compiler is
      for Default_Switches ("C") use
        ("-O2", "-g", "-std=gnu99", "-fPIC", "-fvisibility=hidden",
         "-fno-strict-aliasing", "-fwrapv", "-Wall",
         "-Wno-unused-function", "-Wno-unused-value", "-Wno-unused-variable",
         "-I" & Project'Project_Dir & "v15/vendor",
         "-I" & Project'Project_Dir & "v15/vendor/vendor",
         "-I" & Project'Project_Dir & "v15/vendor/src/include",
         "-I" & Project'Project_Dir & "v15/vendor/src/postgres/include");
   end Compiler;

end Backend_15;
