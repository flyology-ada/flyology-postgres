with "sql.gpr";

project SQL_Examples is
   for Runtime ("Ada") use external ("FLYOLOGY_ROOT") & "/build/alire-rts";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("analyze_sql.adb", "transform_sql_ast.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-g", "-gnat2022", "-gnatwa", "-gnatwJ", "-gnatyM120", "-gnaty-S");
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        (external ("FLYOLOGY_ROOT") & "/build/alire-rts/adalib/libgnarl.a");
   end Linker;
end SQL_Examples;
