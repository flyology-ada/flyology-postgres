with "sql_v14.gpr";
with "sql_v15.gpr";
with "sql_v16.gpr";
with "sql_v17.gpr";
with "sql_v18.gpr";
with "config/flyology_postgres_sql_config.gpr";
project Sql is

   for Languages use ("Ada");
   for Library_Name use "Flyology_Postgres_SQL";
   for Library_Version use
     Project'Library_Name & ".so." & Flyology_Postgres_Sql_Config.Crate_Version;

   for Source_Dirs use ("src/");
   for Source_List_File use "projects/umbrella.sources";
   for Object_Dir use "obj/" & Flyology_Postgres_Sql_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SQL_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Postgres_Sql_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatwJ", "-gnatyM120", "-gnaty-S");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Sql;
