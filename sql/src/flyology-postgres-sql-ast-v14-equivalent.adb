   function Equivalent_Record_Inline_Code_Block
     (Left, Right : Inline_Code_Block; Depth : Natural) return Boolean
   is
   begin
      if Depth > 256 then
         raise Constraint_Error with "excessive owned AST recursion";
      end if;
      if Left.Source_Text.Present /= Right.Source_Text.Present then
         return Fail ("Inline_Code_Block.Source_Text.Present");
      elsif Left.Source_Text.Present then
         if not (Left.Source_Text.Value = Right.Source_Text.Value) then
            return Fail ("Inline_Code_Block.Source_Text.Value");
         end if;
      end if;
      if Left.Lang_Oid.Present /= Right.Lang_Oid.Present then
         return Fail ("Inline_Code_Block.Lang_Oid.Present");
      elsif Left.Lang_Oid.Present then
         if not (Left.Lang_Oid.Value = Right.Lang_Oid.Value) then
            return Fail ("Inline_Code_Block.Lang_Oid.Value");
         end if;
      end if;
      if Left.Lang_Is_Trusted.Present /= Right.Lang_Is_Trusted.Present then
         return Fail ("Inline_Code_Block.Lang_Is_Trusted.Present");
      elsif Left.Lang_Is_Trusted.Present then
         if not (Left.Lang_Is_Trusted.Value = Right.Lang_Is_Trusted.Value) then
            return Fail ("Inline_Code_Block.Lang_Is_Trusted.Value");
         end if;
      end if;
      if Left.Atomic.Present /= Right.Atomic.Present then
         return Fail ("Inline_Code_Block.Atomic.Present");
      elsif Left.Atomic.Present then
         if not (Left.Atomic.Value = Right.Atomic.Value) then
            return Fail ("Inline_Code_Block.Atomic.Value");
         end if;
      end if;
      return True;
   end Equivalent_Record_Inline_Code_Block;

