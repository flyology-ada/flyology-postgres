         when Node_Float_Value =>
            return Equivalent_Record_Float_Value
              (Left => Left.Float_Value_Payload,
               Right => Right.Float_Value_Payload,
               Depth => Depth + 1);
         when Node_String_Value =>
            return Equivalent_Record_String_Value
              (Left => Left.String_Value_Payload,
               Right => Right.String_Value_Payload,
               Depth => Depth + 1);
         when Node_Bit_String_Value =>
            return Equivalent_Record_Bit_String_Value
              (Left => Left.Bit_String_Value_Payload,
               Right => Right.Bit_String_Value_Payload,
               Depth => Depth + 1);
         when Node_Field_Null =>
            return Equivalent_Record_Field_Null
              (Left => Left.Field_Null_Payload,
               Right => Right.Field_Null_Payload,
               Depth => Depth + 1);
         when Node_Node_List_Value =>
            return Equivalent_Record_Node_List_Value
              (Left => Left.Node_List_Value_Payload,
               Right => Right.Node_List_Value_Payload,
               Depth => Depth + 1);
         when Node_Int_List =>
            return Equivalent_Record_Int_List
              (Left => Left.Int_List_Payload,
               Right => Right.Int_List_Payload,
               Depth => Depth + 1);
         when Node_Oid_List =>
            return Equivalent_Record_Oid_List
              (Left => Left.Oid_List_Payload,
               Right => Right.Oid_List_Payload,
               Depth => Depth + 1);
      end case;
   end Equivalent_Node;

begin
   if Left.Valid /= Right.Valid
     or else Left.Source_Text /= Right.Source_Text
     or else Left.Diagnostic_Message /= Right.Diagnostic_Message
     or else Left.Diagnostic_Position /= Right.Diagnostic_Position
   then
      return Fail ("Owned_Syntax_Tree metadata");
   end if;
   return Equivalent_Parse_Result (Left.Root, Right.Root, 0);
end Equivalent;
