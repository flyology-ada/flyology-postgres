   function Equivalent_Node
     (Left, Right : Node_Access; Depth : Natural) return Boolean
   is
   begin
      if Depth > 256 then
         raise Constraint_Error with "excessive owned AST recursion";
      end if;
      if Left = null or else Right = null then
         return Left = Right;
      elsif Left.Kind /= Right.Kind then
         return Fail ("Node.Kind");
      end if;
      case Left.Kind is
         when No_Node =>
            return True;
         when Node_Alias =>
            return Equivalent_Record_Alias
              (Left => Left.Alias_Payload,
               Right => Right.Alias_Payload,
               Depth => Depth + 1);
         when Node_Range_Var =>
            return Equivalent_Record_Range_Var
              (Left => Left.Range_Var_Payload,
               Right => Right.Range_Var_Payload,
               Depth => Depth + 1);
