   function Convert_Native_Sequence_Of_Node
     (Build : Builders.Builder; Items : Builders.Dynamic_Value;
      Depth : Natural) return Sequence_Of_Node
   is
      Value : Sequence_Of_Node;
   begin
      if Depth > 256 then
         raise Constraint_Error with "excessive native AST recursion";
      end if;
      if Items.Kind = Builders.Null_Value then
         return Value;
      elsif Items.Kind /= Builders.List_Value then
         raise Constraint_Error with "native list required";
      end if;
      for Index in 1 .. Build.Length (Items) loop
         declare
            Child : Node_Access := Convert_Native_Node (Build, Build.Element (Items, Index), Depth + 1);
         begin
            Value.Append (Child);
         exception
            when others =>
               Release (Child);
               raise;
         end;
      end loop;
      return Value;
   exception
      when others =>
         for Child of Value loop
            declare
               Copy : Node_Access := Child;
            begin
               Release (Copy);
            end;
         end loop;
         Value.Clear;
         raise;
   end Convert_Native_Sequence_Of_Node;

   function Convert_Native_Sequence_Of_Unsigned_64
     (Build : Builders.Builder; Items : Builders.Dynamic_Value;
      Depth : Natural) return Sequence_Of_Unsigned_64
   is
      Value : Sequence_Of_Unsigned_64;
   begin
      if Depth > 256 then
         raise Constraint_Error with "excessive native AST recursion";
      end if;
      if Items.Kind = Builders.Null_Value then
         return Value;
      elsif Items.Kind /= Builders.List_Value then
         raise Constraint_Error with "native list required";
      end if;
      for Index in 1 .. Build.Length (Items) loop
         Value.Append (Native_Unsigned (Build.Element (Items, Index)));
      end loop;
      return Value;
   end Convert_Native_Sequence_Of_Unsigned_64;

