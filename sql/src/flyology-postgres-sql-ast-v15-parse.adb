   function Convert_Native_Integer_Value
     (Build : Builders.Builder; Item : Builders.Dynamic_Value;
      Depth : Natural) return Integer_Value
   is
      Value : Integer_Value;
   begin
      if Depth > 256 then
         raise Constraint_Error with "excessive native AST recursion";
      end if;
      if Item.Kind /= Builders.Object_Value
        or else Build.Object_Type (Item) /= "Integer"
      then
         raise Constraint_Error with "native Integer object required";
      end if;
      declare
         Source : constant Builders.Dynamic_Value := Build.Field (Item, "ival");
      begin
         if Source.Kind /= Builders.Null_Value and then (Native_Integer (Source) /= 0) then
            Value.Ival := (Present => True, Value => Interfaces.Integer_32 (Native_Integer (Source)));
         end if;
      end;
      return Value;
   exception
      when others =>
         Release_Contents_Integer_Value (Value);
         raise;
   end Convert_Native_Integer_Value;

   function Convert_Native_Float_Value
     (Build : Builders.Builder; Item : Builders.Dynamic_Value;
      Depth : Natural) return Float_Value
   is
      Value : Float_Value;
   begin
      if Depth > 256 then
         raise Constraint_Error with "excessive native AST recursion";
      end if;
      if Item.Kind /= Builders.Object_Value
        or else Build.Object_Type (Item) /= "Float"
      then
         raise Constraint_Error with "native Float object required";
      end if;
      declare
         Source : constant Builders.Dynamic_Value := Build.Field (Item, "fval");
      begin
         if Source.Kind /= Builders.Null_Value and then (Native_Text_Is_Present (Source)) then
            Value.Fval := (Present => True, Value => Native_Text (Source));
         end if;
      end;
      return Value;
   exception
      when others =>
