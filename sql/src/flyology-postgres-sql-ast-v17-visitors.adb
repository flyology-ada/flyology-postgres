   procedure Walk_Parse_Result
     (Self  : in out Visitor'Class;
      Item  : Parse_Result;
      State : in out Traversal_State)
   is
      Control : Traversal_Control := Continue_Traversal;
   begin
      if State.Stopped then
         return;
      end if;
      Enter_Parse_Result (Self, Item, Control);
      case Control is
         when Stop_Traversal =>
            State.Stopped := True;
            return;
         when Skip_Children =>
            null;
         when Continue_Traversal =>
            for Child of Item.Statements loop
               exit when State.Stopped;
               if Child /= null then
                  Walk_Raw_Stmt (Self, Child.all, State);
               end if;
            end loop;
      end case;
      if not State.Stopped then
         Leave_Parse_Result (Self, Item);
      end if;
   end Walk_Parse_Result;

   procedure Walk_Node
     (Self  : in out Visitor'Class;
      Item  : Node;
      State : in out Traversal_State)
   is
      Control : Traversal_Control := Continue_Traversal;
   begin
      if State.Stopped then
         return;
      end if;
      Enter_Node (Self, Item, Control);
      case Control is
         when Stop_Traversal =>
            State.Stopped := True;
            return;
         when Skip_Children =>
            null;
         when Continue_Traversal =>
            case Item.Kind is
               when No_Node =>
                  null;
               when Node_Alias =>
                  Walk_Alias
                    (Self, Item.Alias_Payload, State);
               when Node_Range_Var =>
                  Walk_Range_Var
                    (Self, Item.Range_Var_Payload, State);
               when Node_Table_Func =>
                  Walk_Table_Func
                    (Self, Item.Table_Func_Payload, State);
               when Node_Into_Clause =>
                  Walk_Into_Clause
                    (Self, Item.Into_Clause_Payload, State);
               when Node_Var =>
                  Walk_Var
