with "aunit";
with "sql";
with "../sql_oracle.gpr";

project Sql_Repros is

   for Runtime ("Ada") use external ("FLYOLOGY_ROOT") & "/build/alire-rts";
   --  ../src supplies the test-only validation layers (Differential_Testing,
   --  AST.V*.Testing, Native_Testing) so a reproduction can use them.
   for Source_Dirs use ("src", "../src");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";

   --  Select one reproduction program per build:
   --    ./run.sh repro_sql_xxx
   Main_Name := external ("MAIN", "repro_sql_smoke");
   for Main use (Main_Name & ".adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g", "-O0", "-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwJ");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      for Switches ("Ada") use
        (external ("FLYOLOGY_ROOT") & "/build/alire-rts/adalib/libgnarl.a");
   end Linker;

end Sql_Repros;
