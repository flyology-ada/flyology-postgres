with "../sql.gpr";
with "../backends/backend_14.gpr";
with "../backends/backend_15.gpr";
with "../backends/backend_16.gpr";
with "../backends/backend_17.gpr";
with "../backends/backend_18.gpr";

library project Sql_Oracle is

   for Languages use ("Ada");
   for Source_Dirs use ("oracle/src");
   for Source_Files use
     ("flyology-postgres-sql-backends.ads",
      "flyology-postgres-sql-backends.adb",
      "flyology-postgres-sql-c_oracle.ads",
      "flyology-postgres-sql-c_oracle.adb",
      "flyology-postgres-sql-decoders.ads",
      "flyology-postgres-sql-decoders.adb",
      "flyology-postgres-sql-decoder_v14.ads",
      "flyology-postgres-sql-decoder_v14.adb",
      "flyology-postgres-sql-decoder_v15.ads",
      "flyology-postgres-sql-decoder_v15.adb",
      "flyology-postgres-sql-decoder_v16.ads",
      "flyology-postgres-sql-decoder_v16.adb",
      "flyology-postgres-sql-decoder_v17.ads",
      "flyology-postgres-sql-decoder_v17.adb",
      "flyology-postgres-sql-decoder_v18.ads",
      "flyology-postgres-sql-decoder_v18.adb");
   for Object_Dir use "obj/oracle";
   for Create_Missing_Dirs use "True";
   for Library_Name use "Flyology_Postgres_SQL_Oracle";
   for Library_Dir use "lib/oracle";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-g", "-gnat2022", "-gnatwa", "-gnatwJ",
         "-gnatyM120", "-gnaty-S");
   end Compiler;

end Sql_Oracle;
