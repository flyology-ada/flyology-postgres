with "aunit";
with "sql";
with "sql_oracle.gpr";

project Sql_Tests is

   for Runtime ("Ada") use external ("FLYOLOGY_ROOT") & "/build/alire-rts";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("sql_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-g", "-gnat2022", "-gnatwa", "-gnatwJ", "-gnatyM120", "-gnaty-S");
   end Compiler;

   package Linker is
      --  Flyology's Alire hook prepares this runtime.  Naming the archive
      --  explicitly also makes Alire's preliminary test build select it
      --  before the stock dynamic GNARL on macOS.
      for Switches ("Ada") use
        (external ("FLYOLOGY_ROOT") & "/build/alire-rts/adalib/libgnarl.a");
   end Linker;

end Sql_Tests;
