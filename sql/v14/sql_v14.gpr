with "sql_core.gpr";
with "config/flyology_postgres_sql_v14_config.gpr";
library project Sql_V14 is

   for Languages use ("Ada");
   for Library_Name use "Flyology_Postgres_SQL_V14";
   for Library_Version use
     Project'Library_Name & ".so." & Flyology_Postgres_Sql_V14_Config.Crate_Version;

   for Source_Dirs use ("../src");
   for Source_List_File use "../projects/v14.sources";
   for Object_Dir use "obj/" & Flyology_Postgres_Sql_V14_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external
       ("SQL_V14_LIBRARY_TYPE",
        external ("SQL_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static")));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Postgres_Sql_V14_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatwJ", "-gnatyM120", "-gnaty-S");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Sql_V14;
