        & Encode_Outcome_Accepted (Item.Accepted) & "," &
        Flyology_TLA.Codecs.Encode_String ("hasPrefix") & ":"
        & Encode_Outcome_Has_Prefix (Item.Has_Prefix) & "," &
        Flyology_TLA.Codecs.Encode_String ("wireXid") & ":"
