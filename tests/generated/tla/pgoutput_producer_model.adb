   function Decode_Outcome
     (Source : String;
      Limits : Flyology_TLA.Traces.Load_Limits) return Outcome_Type is
   begin
      if Flyology_TLA.Codecs.Object_Size (Source, Limits) /= 3 then
         raise Flyology_TLA.Codecs.Codec_Error with "unexpected Outcome object shape";
      end if;
      return
        (
         Accepted => Decode_Outcome_Accepted
           (Flyology_TLA.Codecs.Object_Member (Source, "accepted", Limits), Limits),
         Has_Prefix => Decode_Outcome_Has_Prefix
           (Flyology_TLA.Codecs.Object_Member (Source, "hasPrefix", Limits), Limits),
         Wire_Xid => Decode_Outcome_Wire_Xid
           (Flyology_TLA.Codecs.Object_Member (Source, "wireXid", Limits), Limits));
   end Decode_Outcome;

