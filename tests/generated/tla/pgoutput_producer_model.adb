      Limits : Flyology_TLA.Traces.Load_Limits) return Input_Xid_Type is
      pragma Unreferenced (Limits);
      Value : constant String := Flyology_TLA.Codecs.Decode_String (Source);
   begin
      if Value = "None" then
         return Input_Xid_None;
      elsif Value = "T1" then
         return Input_Xid_T1;
      elsif Value = "T2" then
         return Input_Xid_T2;
      end if;
      raise Flyology_TLA.Codecs.Codec_Error with "unknown Input_Xid literal";
   end Decode_Input_Xid;

   function Encode_Input_Xid (Item : Input_Xid_Type) return String is
   begin
      return
        (case Item is
            when Input_Xid_None => """None""",
            when Input_Xid_T1 => """T1""",
            when Input_Xid_T2 => """T2""");
   end Encode_Input_Xid;

