   function Decode_Input
     (Source : String;
      Limits : Flyology_TLA.Traces.Load_Limits) return Input_Type is
   begin
      if Flyology_TLA.Codecs.Object_Size (Source, Limits) /= 5 then
         raise Flyology_TLA.Codecs.Codec_Error with "unexpected Input object shape";
      end if;
      return
        (
         Kind => Decode_Input_Kind
           (Flyology_TLA.Codecs.Object_Member (Source, "kind", Limits), Limits),
         Xid => Decode_Input_Xid
           (Flyology_TLA.Codecs.Object_Member (Source, "xid", Limits), Limits),
         Subxid => Decode_Input_Subxid
           (Flyology_TLA.Codecs.Object_Member (Source, "subxid", Limits), Limits),
         First_Segment => Decode_Input_First_Segment
           (Flyology_TLA.Codecs.Object_Member (Source, "firstSegment", Limits), Limits),
         Transactional => Decode_Input_Transactional
           (Flyology_TLA.Codecs.Object_Member (Source, "transactional", Limits), Limits));
   end Decode_Input;

   function Encode_Input (Item : Input_Type) return String is
   begin
      return
        "{" &
        Flyology_TLA.Codecs.Encode_String ("kind") & ":"
        & Encode_Input_Kind (Item.Kind) & "," &
        Flyology_TLA.Codecs.Encode_String ("xid") & ":"
        & Encode_Input_Xid (Item.Xid) & "," &
        Flyology_TLA.Codecs.Encode_String ("subxid") & ":"
        & Encode_Input_Subxid (Item.Subxid) & "," &
        Flyology_TLA.Codecs.Encode_String ("firstSegment") & ":"
        & Encode_Input_First_Segment (Item.First_Segment) & "," &
        Flyology_TLA.Codecs.Encode_String ("transactional") & ":"
        & Encode_Input_Transactional (Item.Transactional) & "}";
   end Encode_Input;

