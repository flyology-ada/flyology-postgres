with "aunit";
with "config/tests_config.gpr";
project Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use
     ("tests.adb",
      "postgres_test_fiber_exceptions.adb",
      "postgres_test_server.adb",
      "postgres_test_client.adb",
      "postgres_test_cancellation.adb",
      "postgres_test_replication.adb",
      "postgres_test_replication_server.adb",
      "postgres_test_logical_primary.adb",
      "postgres_test_durable_store.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Tests_Config.Ada_Compiler_Switches
        & ("-gnatwJ", "-gnateDFLYOLOGY_CONNECTION_TEST_HOOKS=False");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Tests;
